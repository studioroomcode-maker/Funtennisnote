    {
      "id": "mystery_problem",
      "label": "미스터리 발생·해답 발견",
      "start": 18,
      "end": 45,
      "signature": "{계기}가 생기며 묘한 문제가 하나 생깁니다 → 감각적 현상 → 해답 발견"
    },
    {
      "id": "second_twist",
      "label": "두 번째 반전·유일한 질문·해소",
      "start": 45,
      "end": 72,
      "signature": "그런데 문제가 하나 더 있었습니다 → 왜 바로 ~하지 않았을까요? → 신중한 해소와 전환점"
    },
    {
      "id": "documentary_close",
      "label": "잔여 사실·회수·다큐 종결",
      "start": 72,
      "end": 100,
      "signature": "오해 교정 → 진짜 이유 선언 → 대상 재호명 + 알고 보면 ~였던 것이었습니다"
    }
  ],
  "evidenceLayer": {
    "formula": [
